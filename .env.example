# Example environment variables, not automatically loaded. Do NOT commit real secrets.
SAFEWATCH_DB_HOST=127.0.0.1
SAFEWATCH_DB_PORT=3306
SAFEWATCH_DB_NAME=safewatch
SAFEWATCH_DB_USER=safewatch
SAFEWATCH_DB_PASSWORD=SET_LOCALLY
SAFEWATCH_CAMERA_NUMBER=1
SAFEWATCH_STREAM_URL=http://127.0.0.1:8000/stream.mjpg
SAFEWATCH_STREAM_BIND=127.0.0.1
SAFEWATCH_STREAM_PORT=8000
SAFEWATCH_AFTER_IMAGE=/var/www/html/tensorflow/after.jpg
SAFEWATCH_WARNING_WAV=/home/pi/project/warning.wav
SAFEWATCH_AUDIO_DEVICE=default
SAFEWATCH_ENABLE_SMS=0
SAFEWATCH_ALERT_COOLDOWN_SECONDS=300
SAFEWATCH_ALARM_POLL_SECONDS=10
TWILIO_ACCOUNT_SID=SET_LOCALLY
TWILIO_AUTH_TOKEN=SET_LOCALLY
TWILIO_FROM_NUMBER=SET_LOCALLY
ALERT_RECIPIENT=SET_LOCALLY
