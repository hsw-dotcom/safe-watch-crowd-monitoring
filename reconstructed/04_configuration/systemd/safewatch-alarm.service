[Unit]
Description=Safe Watch DB risk alarm (SMS disabled by default)
After=network-online.target mariadb.service
Wants=network-online.target
[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/project
EnvironmentFile=/etc/safewatch/safewatch.env
ExecStart=/usr/bin/python3 /home/pi/project/alarm.py
Restart=on-failure
RestartSec=10
[Install]
WantedBy=multi-user.target
