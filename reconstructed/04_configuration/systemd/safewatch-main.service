[Unit]
Description=Safe Watch detection and database recorder
After=network-online.target mariadb.service safewatch-stream.service
Wants=network-online.target safewatch-stream.service
[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/project
EnvironmentFile=/etc/safewatch/safewatch.env
ExecStart=/usr/bin/python3 /home/pi/project/main.py
Restart=on-failure
RestartSec=10
[Install]
WantedBy=multi-user.target
